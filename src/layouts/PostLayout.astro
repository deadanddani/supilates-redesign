---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { site } from '../data/site';

interface Props { entrada: CollectionEntry<'blog'>; }
const { entrada } = Astro.props;
const { titulo, descripcion, fecha } = entrada.data;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const formateada = fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout title={`${titulo} | ${site.name}`} description={descripcion}>
  <article class="entrada wrap">
    <a class="volver" href={`${base}/blog`}>&larr; Todos los artículos</a>
    <p class="kick">Blog</p>
    <h1>{titulo}</h1>
    <time datetime={fecha.toISOString().slice(0, 10)}>{formateada}</time>
    <div class="cuerpo"><slot /></div>
  </article>
</BaseLayout>

<style>
  .entrada { padding-block: clamp(2rem, 5vw, 3.5rem) var(--space-xl); max-width: 46rem; }
  .volver { display: inline-flex; align-items: center; min-height: var(--tap); text-decoration: none; color: var(--mor); font-weight: 600; }
  .kick { margin-top: 1rem; }
  h1 { font-size: var(--step-4); margin-block: 0.75rem 1rem; letter-spacing: -0.04em; }
  time { color: var(--muted); font-size: var(--step--1); }
  .cuerpo { margin-top: var(--space-m); padding-top: var(--space-m); border-top: 1px solid var(--line); font-size: var(--step-1); line-height: 1.7; max-width: 65ch; }
  .cuerpo :global(h2) { font-size: var(--step-3); margin-block: var(--space-l) 0.75rem; }
  .cuerpo :global(p), .cuerpo :global(ul), .cuerpo :global(ol) { margin-bottom: 1.25rem; }
  .cuerpo :global(ul), .cuerpo :global(ol) { padding-inline-start: 1.25rem; }
  .cuerpo :global(li) { margin-bottom: 0.4rem; }
  .cuerpo :global(li::marker) { color: var(--mor); }
  .cuerpo :global(a) { color: var(--mor); text-underline-offset: 0.2em; }
</style>
