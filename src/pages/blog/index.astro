---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entradas = (await getCollection('blog'))
  .filter((e) => !e.data.borrador)
  .sort((a, b) => b.data.fecha.getTime() - a.data.fecha.getTime());
---

<BaseLayout
  title={`Blog | ${site.name}`}
  description="Artículos sobre pilates con máquina, postura, dolor de espalda y cómo empezar."
>
  <header class="portada wrap">
    <p class="kick">Actualidad</p>
    <h1>Blog</h1>
  </header>

  <div class="wrap listado">
    {entradas.length === 0 ? (
      <p class="vacio">Pronto habrá artículos aquí.</p>
    ) : (
      entradas.map((e) => (
        <article>
          <time datetime={e.data.fecha.toISOString().slice(0, 10)}>
            {e.data.fecha.toLocaleDateString('es-ES', { day: 'numeric', month: 'long', year: 'numeric' })}
          </time>
          <div>
            <h2><a href={`${base}/blog/${e.id}`}>{e.data.titulo}</a></h2>
            <p>{e.data.descripcion}</p>
          </div>
          <span class="flecha" aria-hidden="true">→</span>
        </article>
      ))
    )}
  </div>
</BaseLayout>

<style>
  .portada { padding-block: clamp(2rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 2.5rem); }
  h1 { margin-top: 0.75rem; }
  h1 { font-size: clamp(3rem, 2rem + 6vw, 6.5rem); letter-spacing: -0.05em; line-height: 0.95; }
  .listado { padding-bottom: var(--space-xl); display: grid; border-top: 1px solid var(--line); }
  /* toda la fila es pulsable: el enlace del titulo se estira sobre ella */
  article {
    position: relative;
    display: grid; grid-template-columns: 11rem 1fr auto; gap: 0.5rem clamp(1rem, 4vw, 3rem);
    align-items: baseline;
    padding-block: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid var(--line);
  }
  time { color: var(--muted); font-size: var(--step--1); font-variant-numeric: tabular-nums; }
  article h2 { font-size: var(--step-2); margin-bottom: 0.5rem; max-width: 26ch; transition: color 0.2s; }
  article h2 a { text-decoration: none; }
  article h2 a::after { content: ''; position: absolute; inset: 0; }
  article p { max-width: 58ch; }
  .flecha { font-size: var(--step-2); color: var(--mor); transition: transform 0.3s var(--ease-out); }
  article:hover h2 { color: var(--mor); }
  article:hover .flecha { transform: translateX(6px); }
  article:has(a:focus-visible) { outline: 3px solid var(--mor); outline-offset: 4px; border-radius: var(--radius-s); }
  article h2 a:focus-visible { outline: none; }
  .vacio { font-family: var(--font-display); font-size: var(--step-2); color: var(--ink); padding-block: var(--space-l); }
  @media (max-width: 47.5rem) {
    article { grid-template-columns: 1fr; }
    .flecha { display: none; }
  }
</style>
