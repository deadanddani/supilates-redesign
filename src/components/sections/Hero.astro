---
import { Image } from 'astro:assets';
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import heroImg from '../../assets/images/hero-reformer.jpg';
---

<section class="hero">
  <div class="texto">
    <p class="kick">Pilates con máquina en {site.city}</p>
    <h1>Fortalece tu cuerpo, <em>mente y espíritu</em></h1>
    <p class="entrada">
      Clases de 55 minutos en grupos de 4 o 5 personas, con una rutina adaptada a ti.
    </p>
    <div class="botones">
      <Button href={site.whatsapp} external>{site.cta}</Button>
      <a class="enlace" href="#horarios">Ver horarios</a>
    </div>
  </div>

  <div class="figura">
    <div class="halo" aria-hidden="true"></div>
    <div class="media">
      <Image
        src={heroImg}
        alt="Alumna trabajando sobre el reformer en el estudio"
        widths={[420, 640, 900, 1200]}
        sizes="(max-width: 53.75rem) 92vw, 44vw"
        loading="eager"
        fetchpriority="high"
        id="hero-img"
      />
    </div>
  </div>
</section>

<style>
  .hero {
    overflow-x: clip; /* el halo sangra a proposito; que no genere scroll */
    max-width: var(--wrap);
    margin-inline: auto;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(3rem, 6vw, 5rem);
    padding-inline: var(--pad-l) var(--pad-r);
    display: grid;
    grid-template-columns: 1.3fr 0.7fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }

  h1 {
    /* Escala propia: el hero ocupa media columna, no el ancho completo. */
    font-size: clamp(2.5rem, 1.5rem + 3.4vw, 4.25rem);
    line-height: 1;
    letter-spacing: -0.045em;
    margin-block: 1.25rem 1.5rem;
  }

  .entrada {
    font-size: var(--step-1);
    line-height: 1.5;
    max-width: 30ch;
    margin-bottom: 2rem;
  }

  .botones {
    display: flex;
    align-items: center;
    gap: 0.75rem 1.75rem;
    flex-wrap: wrap;
  }

  .figura {
    position: relative;
    isolation: isolate;
  }

  /* Luz suave detras del arco: fija, sin JavaScript. */
  .halo {
    position: absolute;
    inset: -8% -10% auto auto;
    z-index: -1;
    width: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 40% 40%, rgb(125 31 143 / 0.14), transparent 65%);
    pointer-events: none;
  }

  .media {
    overflow: hidden;
    border-radius: 50% 50% var(--radius-l) var(--radius-l) / 32% 32% var(--radius-l) var(--radius-l);
    aspect-ratio: 3 / 3.7;
    box-shadow: var(--shadow-m);
  }

  .media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Parallax ligado al scroll: la foto se desplaza y amplia un poco al salir. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .media :global(img) {
        animation: deriva linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
    }
  }

  @keyframes deriva {
    to {
      transform: translateY(-7%) scale(1.08);
    }
  }

  /* Entrada del hero al cargar: primero el texto, luego la foto. */
  @media (prefers-reduced-motion: no-preference) {
    .texto > * {
      animation: sube 0.9s var(--ease-out) both;
    }
    .texto > :nth-child(2) { animation-delay: 0.06s; }
    .texto > :nth-child(3) { animation-delay: 0.14s; }
    .texto > :nth-child(4) { animation-delay: 0.22s; }
    .media {
      animation: aparece 1.1s var(--ease-out) 0.1s both;
    }
  }

  @keyframes sube {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
  }

  @keyframes aparece {
    from {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  @media (max-width: 53.75rem) {
    .hero {
      grid-template-columns: 1fr;
      padding-top: 0.5rem;
    }

    h1 {
      max-width: 13ch;
    }

    .figura {
      max-width: 34rem;
    }

    .media {
      aspect-ratio: 4 / 3.6;
      border-radius: 40% 40% var(--radius-l) var(--radius-l) / 28% 28% var(--radius-l) var(--radius-l);
    }
  }

  @media (max-width: 30rem) {
    .botones :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
