---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
---
<section class="horarios" id="horarios">
  <div class="wrap">
    <div class="panel rv">
      <div class="intro">
        <h2>Flexibles, de <em>lunes a sábado</em></h2>
        <p>Rutinas personalizadas en función de tus necesidades y posibilidades.</p>
        <Button href={site.whatsapp} external>{site.cta}</Button>
      </div>

      <dl class="tabla">
        {site.hours.map((h) => (
          <div class="fila">
            <dt>{h.days}</dt>
            <dd>{h.time}</dd>
          </div>
        ))}
        <div class="fila verano">
          <dt><Icon name="reloj" size={18} /> Julio y agosto</dt>
          <dd>Horario completo. No cerramos en verano.</dd>
        </div>
      </dl>
    </div>
  </div>
</section>

<style>
  .horarios { padding-block: 0 var(--space-xl); }

  .panel {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
    background: var(--lila);
    border-radius: var(--radius-l);
    padding: clamp(1.75rem, 5vw, 4rem);
  }

  h2 { margin-bottom: 1.125rem; max-width: 11ch; }
  .intro p { max-width: 34ch; margin-bottom: 1.75rem; }

  .tabla { margin: 0; display: grid; gap: 0.75rem; }
  .fila {
    display: flex; justify-content: space-between; align-items: baseline;
    flex-wrap: wrap; gap: 0.25rem 1.5rem;
    background: var(--surf);
    border-radius: var(--radius-m);
    padding: 1.125rem 1.375rem;
  }
  dt { font-weight: 600; color: var(--ink); display: inline-flex; align-items: center; gap: 0.5rem; }
  dt :global(svg) { color: var(--mor); }
  dd {
    margin: 0;
    font-family: var(--font-display); font-size: var(--step-2); font-weight: 500;
    letter-spacing: -0.03em; color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .verano { background: transparent; border: 1.5px dashed #cdb9d3; }
  .verano dd { font-family: var(--font-body); font-size: var(--step-0); font-weight: 400; letter-spacing: 0; color: var(--body); }

  @media (max-width: 53.75rem) {
    .panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 30rem) {
    .fila { flex-direction: column; align-items: flex-start; }
  }
</style>
