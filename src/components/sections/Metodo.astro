---
import { Image } from 'astro:assets';
import img1 from '../../assets/images/metodo-plancha.jpg';
import img2 from '../../assets/images/metodo-madera.jpg';
import img3 from '../../assets/images/metodo-estiramiento.jpg';

const fotos = [
  { src: img1, alt: 'Trabajo de plancha sobre el reformer', pie: 'Reformer', clase: 'ancha' },
  { src: img2, alt: 'Alumna tumbada trabajando la postura', pie: 'Trabajo de postura', clase: 'alta' },
  { src: img3, alt: 'Estiramiento lateral guiado en la máquina', pie: 'Grupos de 4 o 5', clase: 'baja' },
];
---
<section class="metodo seccion" id="metodo">
  <div class="wrap rejilla">
    <div class="fija">
      <h2 class="rv">Así se trabaja en el <em>pilates con máquina</em></h2>
      <p class="rv rv-d1">
        Las clases duran 55 min aprox y se trabaja todo el cuerpo, a nivel muscular tonificando,
        la postura corporal y la elongación.
      </p>
      <p class="rv rv-d2">
        Si bien la clase es grupal no habrá más de 4 o 5 personas, por eso se puede hacer una
        rutina especial para cada alumno según las necesidades y capacidades individuales.
      </p>
      <a class="enlace rv rv-d3" href="#servicios">Ver las clases</a>
    </div>

    <div class="collage">
      {fotos.map((f, i) => (
        <figure class:list={[f.clase, 'rv', `rv-d${i + 1}`]}>
          <div class="marco">
            <Image src={f.src} alt={f.alt} widths={[400, 700, 1000]} sizes={i === 0 ? '(max-width: 53.75rem) 92vw, 52vw' : '(max-width: 53.75rem) 46vw, 26vw'} loading="lazy" />
          </div>
          <figcaption>{f.pie}</figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .rejilla {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: clamp(2rem, 7vw, 6rem);
    align-items: start;
  }

  .fija { position: sticky; inset-block-start: 7rem; }
  .fija h2 { margin-bottom: 1.5rem; max-width: 12ch; }
  .fija p { max-width: 42ch; }
  .fija p + p { margin-top: 1rem; }
  .fija .enlace { margin-top: 1.25rem; }

  .collage {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1rem, 2.5vw, 1.75rem);
    align-items: start;
  }

  figure { margin: 0; }
  .marco { border-radius: var(--radius-l); overflow: hidden; background: var(--lila); }
  .marco :global(img) {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.9s var(--ease-out);
  }
  figure:hover .marco :global(img) { transform: scale(1.03); }

  .ancha { grid-column: 1 / -1; }
  .ancha .marco { aspect-ratio: 16 / 10; }
  .alta .marco { aspect-ratio: 4 / 5; }
  .baja { margin-top: clamp(2rem, 8vw, 6rem); }
  .baja .marco { aspect-ratio: 1; }

  figcaption {
    margin-top: 0.75rem;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--muted);
  }

  @media (max-width: 53.75rem) {
    .rejilla { grid-template-columns: 1fr; }
    .fija { position: static; }
    .fija h2 { max-width: 16ch; }
  }
</style>
