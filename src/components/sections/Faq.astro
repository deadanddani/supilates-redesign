---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';
import Accordion from '../ui/Accordion.astro';

interface Props { items: CollectionEntry<'faq'>[]; }
const { items } = Astro.props;

const preguntas = await Promise.all(
  items.map(async (f) => ({
    pregunta: f.data.pregunta,
    Contenido: (await render(f)).Content,
  })),
);
---
<section class="faq seccion" id="faq">
  <div class="wrap">
    <div class="rejilla">
      <h2 class="rv">Lo que más <em>nos preguntáis</em></h2>
      <Accordion items={preguntas} class="rv rv-d1" />
    </div>
  </div>
</section>

<style>
  .faq { background: var(--surf); }
  .rejilla { display: grid; grid-template-columns: 0.7fr 1.3fr; gap: var(--space-l); align-items: start; }
  h2 { max-width: 10ch; position: sticky; inset-block-start: 7rem; }
  @media (max-width: 53.75rem) {
    .rejilla { grid-template-columns: 1fr; gap: var(--space-m); }
    h2 { position: static; max-width: 14ch; }
  }
</style>
