---
import type { CollectionEntry } from 'astro:content';
import { site } from '../../data/site';
import Icon from '../ui/Icon.astro';
import Button from '../ui/Button.astro';

interface Props { items: CollectionEntry<'servicios'>[]; }
const { items } = Astro.props;
const destacado = items.find((s) => s.data.destacado);
const resto = items.filter((s) => !s.data.destacado);
---
<section class="servicios seccion" id="servicios">
  <div class="wrap">
    <header class="cabecera">
      <h2 class="rv">A tu ritmo, sea cual sea <em>tu punto de partida</em></h2>
      <p class="rv rv-d1">
        ¿Estás buscando una forma efectiva y segura de mejorar tu salud y flexibilidad?
        Nuestra clase de Pilates en máquina es la respuesta.
      </p>
    </header>

    <ul class="rejilla">
      {destacado && (
        <li class="celda destacada rv">
          <div>
            <Icon name={destacado.data.icono} size={30} />
            <h3>{destacado.data.titulo}</h3>
            <p>{destacado.data.resumen}</p>
          </div>
          <Button href={site.whatsapp} external class="unirme">{site.cta}</Button>
        </li>
      )}
      {resto.map((s, i) => (
        <li class:list={['celda', 'rv', `rv-d${Math.min(i + 1, 6)}`]}>
          <Icon name={s.data.icono} size={26} />
          <h3>{s.data.titulo}</h3>
          <p>{s.data.resumen}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cabecera { max-width: 40rem; margin-bottom: var(--space-l); }
  .cabecera h2 { margin-bottom: 1.125rem; }
  .cabecera p { font-size: var(--step-1); line-height: 1.5; max-width: 46ch; }

  /*
   * 7 servicios, 7 celdas: la destacada ocupa dos filas y las otras seis
   * rellenan una rejilla de 3 x 2. Fondos alternos para que no sea una
   * pared de tarjetas iguales.
   */
  .rejilla {
    list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: 1.25fr repeat(3, 1fr); gap: 0.75rem;
  }
  .celda {
    display: flex; flex-direction: column;
    border-radius: var(--radius-l);
    padding: clamp(1.375rem, 2.5vw, 1.875rem);
    background-color: var(--surf);
    color: var(--body);
    transition: transform 0.35s var(--ease-out), box-shadow 0.35s;
  }
  .celda:nth-child(3), .celda:nth-child(5), .celda:nth-child(7) { background-color: var(--lila); }
  .celda:hover { transform: translateY(-4px); box-shadow: var(--shadow-m); }
  .celda :global(svg) { color: var(--mor); flex: none; }
  h3 { font-size: var(--step-1); margin-block: 1.75rem 0.5rem; }
  .celda p { font-size: var(--step--1); line-height: 1.55; }

  .destacada {
    grid-row: span 2;
    justify-content: space-between; gap: 2rem;
    background-color: var(--mor);
    background-image: radial-gradient(circle at 110% -10%, rgb(255 255 255 / 0.16), transparent 55%);
    color: rgb(255 255 255 / 0.88);
  }
  .destacada:hover { transform: none; box-shadow: none; }
  .destacada :global(svg) { color: #fff; }
  .destacada > div { display: flex; flex-direction: column; }
  .destacada h3 { color: #fff; font-size: var(--step-3); margin-top: 3.5rem; }
  .destacada p { font-size: var(--step-0); max-width: 26ch; }
  .unirme { background: var(--surf); color: var(--mor); align-self: flex-start; }
  .unirme:hover { background: #fff; color: var(--mor-h); }

  @media (max-width: 60rem) {
    .rejilla { grid-template-columns: 1fr 1fr; }
    .destacada { grid-column: 1 / -1; grid-row: auto; }
    .destacada h3 { margin-top: 2rem; }
    .celda:nth-child(n) { background-color: var(--surf); }
    .celda:nth-child(4n + 2), .celda:nth-child(4n + 5) { background-color: var(--lila); }
    .destacada.destacada { background-color: var(--mor); }
  }
  @media (max-width: 30rem) {
    .rejilla { grid-template-columns: 1fr; }
    h3 { margin-top: 1.25rem; }
    .celda:nth-child(n) { background-color: var(--surf); }
    .celda:nth-child(odd) { background-color: var(--lila); }
    .destacada.destacada { background-color: var(--mor); }
  }
</style>
