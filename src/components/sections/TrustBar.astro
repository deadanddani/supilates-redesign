---
import { site } from '../../data/site';
const { count } = site.reviews;
const { classMinutes, groupSize, monthsOpen } = site.facts;
---
<section class="confianza" aria-label="Datos del estudio">
  <div class="wrap">
  <div class="fila">
    <a class="dato" href="#testimonios">
      <span class="valor"><span data-count={count}>{count}</span></span>
      <span class="clave">Reseñas en {site.reviews.source}</span>
    </a>
    <div class="dato">
      <span class="valor"><span data-count={classMinutes}>{classMinutes}</span><small>min</small></span>
      <span class="clave">Duración de clase</span>
    </div>
    <div class="dato">
      <span class="valor"><span data-count={groupSize}>{groupSize}</span></span>
      <span class="clave">Alumnas por grupo</span>
    </div>
    <div class="dato">
      <span class="valor">{monthsOpen}</span>
      <span class="clave">Meses al año abierto</span>
    </div>
  </div>
  </div>
</section>

<style>
  .fila {
    display: grid; grid-template-columns: repeat(4, 1fr);
    border-block: 1px solid var(--line);
  }
  .dato {
    display: flex; flex-direction: column; gap: 0.35rem;
    padding: clamp(1.25rem, 3vw, 2rem) clamp(0.75rem, 2vw, 1.5rem);
    text-decoration: none;
  }
  .dato + .dato { border-inline-start: 1px solid var(--line); }
  .dato:first-child { padding-inline-start: 0; }
  a.dato { transition: color 0.2s; }
  a.dato:hover .valor { color: var(--mor); }
  a.dato:hover .clave { text-decoration: underline; text-underline-offset: 0.25em; }
  .valor {
    font-family: var(--font-display); font-size: var(--step-4); font-weight: 500;
    letter-spacing: -0.04em; color: var(--ink); line-height: 1;
    font-variant-numeric: tabular-nums; transition: color 0.2s;
  }
  .valor small { font-size: 0.45em; letter-spacing: -0.01em; margin-inline-start: 0.15em; }
  .clave { font-size: var(--step--1); color: var(--muted); line-height: 1.35; }

  @media (max-width: 47.5rem) {
    .fila { grid-template-columns: 1fr 1fr; }
    .dato + .dato:nth-child(3) { border-inline-start: 0; padding-inline-start: 0; }
    .dato:nth-child(n + 3) { border-top: 1px solid var(--line); }
  }
</style>
