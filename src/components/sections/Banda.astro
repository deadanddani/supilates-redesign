---
import { Image } from 'astro:assets';
import banda from '../../assets/images/banda-estudio.jpg';
---
{/* Solo fotografia: sin texto superpuesto ni velo oscuro encima. */}
<div class="banda">
  <div class="interior" id="banda">
    <Image src={banda} alt="Sala del estudio con varias máquinas de pilates" widths={[700, 1200, 1800, 2400]} sizes="100vw" loading="lazy" />
  </div>
</div>

<style>
  .interior {
    position: relative; overflow: hidden;
    width: 100%;
    height: clamp(15rem, 48vw, 36rem);
  }
  .interior :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /*
   * La foto se abre al entrar: empieza recortada como una ventana redondeada
   * y termina a sangre. Solo clip-path y transform: la caja mide siempre el
   * 100% y no provoca reflujo.
   */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .interior {
        animation: abre linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }
      .interior :global(img) {
        animation: acerca linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 60%;
      }
    }
  }

  @keyframes abre {
    from { clip-path: inset(0 19% round var(--radius-l)); }
    to { clip-path: inset(0 0 round 0); }
  }

  @keyframes acerca {
    from { transform: scale(1.12); }
    to { transform: scale(1); }
  }
</style>
