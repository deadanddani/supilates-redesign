---
import type { CollectionEntry } from 'astro:content';
import { render } from 'astro:content';

interface Props { items: CollectionEntry<'testimonios'>[]; }
const { items } = Astro.props;
const conTexto = await Promise.all(
  items.map(async (t) => ({ data: t.data, Contenido: (await render(t)).Content })),
);
---
{/* Las tarjetas se apilan una sobre otra con position: sticky. */}
<section class="testimonios seccion" id="testimonios">
  <div class="wrap">
    <p class="kick rv">Testimonios</p>
    <h2 class="rv rv-d1">Lo que dicen sus alumnas</h2>

    <div class="pila">
      {conTexto.map(({ data, Contenido }) => (
        <figure class="tarjeta">
          <div class="estrellas" aria-label="5 sobre 5"><span aria-hidden="true">★★★★★</span></div>
          <blockquote><Contenido /></blockquote>
          <figcaption>
            <span class="quien">{data.autor}</span>
            <span class="fuente">{data.fuente}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonios { background: var(--lila); }
  h2 { margin-block: 0.875rem var(--space-l); }
  .pila { display: grid; }
  .tarjeta {
    position: sticky; margin: 0 0 1.375rem;
    background: var(--surf); border-radius: var(--radius-l);
    padding: clamp(1.75rem, 4vw, 3.25rem);
    box-shadow: 0 -0.375rem 2.5rem rgb(62 28 74 / 0.09);
  }
  .tarjeta:nth-child(1) { inset-block-start: 16vh; }
  .tarjeta:nth-child(2) { inset-block-start: 18vh; }
  .tarjeta:nth-child(3) { inset-block-start: 20vh; }
  .tarjeta:nth-child(4) { inset-block-start: 22vh; }
  .estrellas { color: var(--star); letter-spacing: 4px; margin-bottom: 0.875rem; }
  blockquote :global(p) {
    font-family: var(--font-display); font-size: var(--step-2); line-height: 1.35;
    color: var(--ink); font-weight: 300; margin-bottom: 1.25rem;
  }
  figcaption { display: grid; gap: 0.1rem; }
  .quien { font-weight: 700; color: var(--ink); }
  .fuente { font-size: var(--step--1); color: var(--muted); }

  @media (prefers-reduced-motion: reduce) { .tarjeta { position: static; } }
  @media (max-width: 47.5rem) { .tarjeta { position: static; } }
</style>
