---
/*
 * Menu movil con <details>: se abre y cierra sin JavaScript.
 */
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const enlaces = [
  { href: `${base}/`, texto: 'Inicio' },
  { href: `${base}/nosotros`, texto: 'Nosotros' },
  { href: `${base}/blog`, texto: 'Blog' },
];
const actual = Astro.url.pathname.replace(/\/$/, '') || base;
---
<nav class="escritorio" aria-label="Principal">
  <ul>
    {enlaces.map((e) => (
      <li>
        <a href={e.href} aria-current={e.href.replace(/\/$/, '') === actual ? 'page' : undefined}>{e.texto}</a>
      </li>
    ))}
  </ul>
</nav>

<details class="movil">
  <summary aria-label="Abrir el menú">
    <span class="barras" aria-hidden="true"><span></span><span></span><span></span></span>
  </summary>
  <nav aria-label="Principal (móvil)">
    <ul>
      {enlaces.map((e) => (
        <li><a href={e.href}>{e.texto}</a></li>
      ))}
    </ul>
  </nav>
</details>

<style>
  ul { list-style: none; margin: 0; padding: 0; }
  .escritorio ul { display: flex; gap: clamp(1rem, 2.5vw, 1.75rem); }
  .escritorio a {
    display: inline-flex; align-items: center; min-height: var(--tap);
    font-size: var(--step--1); letter-spacing: 0.1em; text-transform: uppercase;
    color: var(--ink); text-decoration: none; position: relative;
  }
  .escritorio a::after {
    content: ''; position: absolute; inset-inline-start: 0; inset-block-end: 0.5rem;
    height: 1.5px; width: 0; background: var(--mor); transition: width 0.28s;
  }
  .escritorio a:hover::after, .escritorio a[aria-current='page']::after { width: 100%; }

  .movil { display: none; position: relative; }
  .movil summary {
    display: flex; align-items: center; justify-content: center;
    width: var(--tap); height: var(--tap); cursor: pointer; list-style: none;
  }
  .movil summary::-webkit-details-marker { display: none; }
  .barras { display: grid; gap: 4px; width: 1.375rem; }
  .barras span { display: block; height: 2px; background: var(--ink); border-radius: 2px; }
  .movil[open] nav {
    position: absolute; inset-inline-end: 0; inset-block-start: calc(var(--tap) + 0.5rem);
    min-width: 11rem; background: var(--surf); border: 1px solid var(--line);
    border-radius: var(--radius-m); padding: 0.5rem; box-shadow: 0 1rem 2.5rem rgb(62 28 74 / 0.14);
  }
  .movil nav a {
    display: flex; align-items: center; min-height: var(--tap); padding-inline: 0.75rem;
    border-radius: var(--radius-s); color: var(--ink); text-decoration: none; font-weight: 600;
  }
  .movil nav a:hover { background: var(--lila); }

  @media (max-width: 51.25rem) {
    .escritorio { display: none; }
    .movil { display: block; }
  }
</style>
