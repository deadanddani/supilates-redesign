---
import { site } from '../../data/site';
import Logo from './Logo.astro';
import Nav from './Nav.astro';
import Button from '../ui/Button.astro';
---
<header class="cab" id="cabecera">
  <div class="fila">
    <Logo />
    <Nav />
    <div class="acciones">
      <a class="tel" href={site.phoneHref}>{site.phone}</a>
      <Button href={site.whatsapp} external class="cta">{site.cta}</Button>
    </div>
  </div>
</header>

<style>
  .cab {
    --logo-h: 3rem;
    position: sticky; inset-block-start: 0; z-index: var(--z-header);
    padding-block: 0.875rem;
    transition: background-color 0.35s, box-shadow 0.35s;
  }
  .cab:global(.shrunk) {
    --logo-h: 2.375rem;
    padding-block: 0.4rem;
    background: rgb(248 245 249 / 0.86);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    box-shadow: 0 1px 0 var(--line);
  }
  @media (prefers-reduced-transparency: reduce) {
    .cab:global(.shrunk) { background: var(--bone); backdrop-filter: none; -webkit-backdrop-filter: none; }
  }

  .fila {
    max-width: var(--wrap); margin-inline: auto; padding-inline: var(--pad-l) var(--pad-r);
    display: flex; align-items: center; gap: clamp(1rem, 3vw, 2.25rem);
  }
  .acciones { margin-inline-start: auto; display: flex; align-items: center; gap: 1rem; }
  .tel {
    display: inline-flex; align-items: center; min-height: var(--tap);
    font-weight: 600; text-decoration: none; color: var(--ink); white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .tel:hover { color: var(--mor); }
  .cta { padding: 0.6rem 1.2rem; font-size: var(--step--1); }

  @media (max-width: 51.25rem) {
    .acciones { gap: 0.25rem; }
    .cta { display: none; }
  }
  @media (max-width: 26rem) {
    .tel { font-size: var(--step--1); }
  }
</style>
