---
import { site } from '../../data/site';
import Logo from './Logo.astro';
import Nav from './Nav.astro';
import Button from '../ui/Button.astro';
---
<header class="cab" id="cabecera">
  <div class="fila">
    <Logo />
    <Nav />
    <div class="acciones">
      <a class="tel" href={site.phoneHref}>{site.phone}</a>
      <Button href={site.whatsapp} variant="green" external class="cta">Reserva por WhatsApp</Button>
    </div>
  </div>
</header>

<style>
  .cab {
    position: sticky; inset-block-start: 0; z-index: 50;
    transition: padding 0.35s, background 0.35s, box-shadow 0.35s;
    padding-block: 1.125rem;
  }
  .cab:global(.shrunk) {
    padding-block: 0.5rem;
    background: rgb(247 243 238 / 0.88);
    backdrop-filter: blur(14px);
    box-shadow: 0 1px 0 var(--line);
  }
  .cab:global(.shrunk) { --logo-h: 2rem; }

  .fila {
    max-width: var(--wrap); margin-inline: auto; padding-inline: var(--gutter);
    display: flex; align-items: center; gap: clamp(1rem, 3vw, 1.75rem);
  }
  .acciones { margin-inline-start: auto; display: flex; align-items: center; gap: 0.875rem; }
  .tel {
    display: inline-flex; align-items: center; min-height: var(--tap);
    font-weight: 600; text-decoration: none; color: var(--ink); white-space: nowrap;
  }
  .tel:hover { color: var(--mor); }
  .cta { padding: 0.625rem 1.125rem; font-size: var(--step--1); }

  @media (max-width: 51.25rem) {
    .acciones { gap: 0.5rem; }
    .cta { display: none; }
  }
  @media (max-width: 26rem) {
    .tel { font-size: var(--step--1); }
  }
</style>
